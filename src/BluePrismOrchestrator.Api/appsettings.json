{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrchestratorDb": "Host=localhost;Database=BluePrismOrchestrator;Username=postgres;Password=postgres;",
    "BluePrismDb": "Server=(LocalDB)\\BluePrismLocalDB;Database=BluePrism;Integrated Security=True;Connect Timeout=5;"
  },
  "AutomateC": {
    "ExecutablePath": "C:\\Program Files\\Blue Prism Limited\\Blue Prism Automate\\AutomateC.exe",
    "AuthMode": "SSO",
    "Username": "",
    "Password": "",
    "DbConnectionName": "BluePrism",
    "TimeoutSeconds": 120,
    "MaxConcurrentInvocations": 4
  },
  "BluePrismDb": {
    "ConnectionString": "Server=(LocalDB)\\BluePrismLocalDB;Database=BluePrism;Integrated Security=True;Connect Timeout=5;",
    "PollingIntervalSeconds": 10
  },
  "BusinessOutput": {
    "BasePath": "C:\\BluePrism\\Output",
    "LookbackMinutes": 30
  },
  "Alerts": {
    "Smtp": {
      "Host": "smtp.office365.com",
      "Port": 587,
      "Username": "orchestrator@company.com",
      "Password": "",
      "FromAddress": "orchestrator@company.com",
      "UseSsl": true
    },
    "Teams": {
      "WebhookUrl": ""
    },
    "Webhook": {
      "Url": "",
      "Headers": {}
    }
  },
  "LLM": {
    "Provider": "OpenAI",
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "DefaultModel": "gpt-4o-mini",
    "MaxTokens": 4096,
    "Temperature": 0.7,
    "AvailableModels": [
      { "id": "gpt-4o", "name": "GPT-4o", "maxTokens": 16384 },
      { "id": "gpt-4o-mini", "name": "GPT-4o Mini", "maxTokens": 8192 },
      { "id": "gpt-3.5-turbo", "name": "GPT-3.5 Turbo", "maxTokens": 4096 },
      { "id": "o1-mini", "name": "o1 Mini", "maxTokens": 8192 }
    ],
    "CustomEndpoints": [
      {
        "id": "ollama-llama3",
        "name": "Ollama - Llama 3 8B (Local)",
        "url": "http://localhost:11434/v1",
        "apiKey": null,
        "model": "llama3",
        "provider": "Ollama"
      },
      {
        "id": "ollama-mistral",
        "name": "Ollama - Mistral 7B (Local)",
        "url": "http://localhost:11434/v1",
        "apiKey": null,
        "model": "mistral",
        "provider": "Ollama"
      },
      {
        "id": "lmstudio",
        "name": "LM Studio (Local)",
        "url": "http://localhost:1231/v1",
        "apiKey": null,
        "model": "llama-3-8b-instruct",
        "provider": "LMStudio"
      },
      {
        "id": "azure-openai",
        "name": "Azure OpenAI (External)",
        "url": "https://YOUR-RESOURCE.openai.azure.com/openai/deploy/YOUR-DEPLOYMENT",
        "apiKey": "YOUR-AZURE-KEY",
        "model": "gpt-4o",
        "provider": "AzureOpenAI"
      },
      {
        "id": "anthropic-claude",
        "name": "Anthropic Claude (External)",
        "url": "https://api.anthropic.com/v1",
        "apiKey": "YOUR-ANTHROPIC-KEY",
        "model": "claude-3-5-sonnet-20241022",
        "provider": "Anthropic"
      }
    ]
  }
}
